@using Masuit.MyBlogs.Core.Common
@using Microsoft.AspNetCore.Http.Extensions
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv='content-language' content='zh-CN'>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>正在验证客户端环境，请稍候......</title>
    <meta name="keywords" content="@CommonHelper.SystemSettings["Keyword"]" />
    <meta name="description" content="@CommonHelper.SystemSettings["Description"]" />
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#ffffff">
    <meta name="twitter:card" content="summary">
    <meta property="og:title" content="@CommonHelper.SystemSettings["Title"]">
    <meta property="og:description" content="@CommonHelper.SystemSettings["Description"]">
    <meta property="og:type" content="website">
    <meta property="og:url" content="@Context.Request.GetEncodedUrl()">
    <meta property="og:image" content="/favicon.png" />
    <meta property="og:image:alt" content="@CommonHelper.SystemSettings["Description"]" />
    <meta property="og:locale" content="zh_CN">
    <meta property="og:author" content="@CommonHelper.SystemSettings["Title"]" />
    <meta property="og:release_date" content="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
    <meta property="article:author" content="@CommonHelper.SystemSettings["Title"]" />
    <meta property="article:published_time" content="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
    <meta property="article:modified_time" content="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="~/Scripts/layer/layer.js"></script>
    <script src="/Scripts/global/functions.js"></script>
    <style>
        :root {
            color-scheme: light;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
            color: #17243a;
            background: #f3f6fb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 28px 16px;
            background: radial-gradient(ellipse at top left, #e7f0ff 0, transparent 48%), #f3f6fb;
        }

        .challenge-card {
            width: min(100%, 480px);
            padding: 40px;
            border: 1px solid #e7ebf2;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 20px 60px rgba(31, 51, 83, .10);
            text-align: center;
        }

        .challenge-icon {
            width: 56px;
            height: 56px;
            margin: 0 auto 20px;
            display: grid;
            place-items: center;
            border-radius: 17px;
            background: #edf4ff;
            color: #2874d0;
            font-size: 27px;
        }

        h1 {
            margin: 0;
            font-size: 23px;
            font-weight: 700;
            letter-spacing: .01em;
        }

        .description {
            margin: 12px 0 26px;
            color: #6a778b;
            font-size: 14px;
            line-height: 1.8;
        }

        .verification {
            display: flex;
            justify-content: center;
            min-height: 66px;
        }

        .hint {
            margin: 17px 0 0;
            color: #8792a3;
            font-size: 12px;
            line-height: 1.7;
        }

        .continue-button {
            width: 100%;
            margin-top: 22px;
            padding: 12px 18px;
            border: 0;
            border-radius: 10px;
            background: #2874d0;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s ease, transform .2s ease;
        }

        .continue-button:hover {
            background: #1c61b4;
            transform: translateY(-1px);
        }

        .noscript-message {
            position: fixed;
            inset: 0;
            z-index: 2;
            display: grid;
            place-items: center;
            padding: 24px;
            background: #f3f6fb;
            text-align: center;
        }

        .noscript-message h2 {
            max-width: 520px;
            font-size: 20px;
            line-height: 1.7;
        }

        @@media (max-width: 520px) {
            .challenge-card {
                padding: 32px 22px;
                border-radius: 16px;
            }
        }
    </style>
</head>
<body>
    <noscript>
        <div class="noscript-message">
            <h2>检测到您的浏览器不支持 JavaScript 或已禁用 JavaScript 功能，当前页面无法正常显示。</h2>
        </div>
    </noscript>
    <main class="challenge-card">
        <div class="challenge-icon" aria-hidden="true">✓</div>
        <h1>安全验证</h1>
        <p class="description">为了保护网站安全，请完成下方验证后继续访问。</p>
        <form asp-controller="Firewall" asp-action="CloudflareTurnstileHandler" method="post">
            @Html.AntiForgeryToken()
            <div class="verification">
                <div class="cf-turnstile" data-sitekey="@CommonHelper.SystemSettings["TurnstileClientKey"]" data-theme="light"></div>
            </div>
            <p class="hint">若验证码未正常加载，请刷新页面，或检查浏览器扩展是否拦截了验证。</p>
            <button id="btn" class="continue-button" type="submit" style="display: none">验证完成，进入网站</button>
        </form>
    </main>
@Html.Raw(CommonHelper.SystemSettings["Scripts"])
</body>
</html>
<script>
    $(function() {
        const interval = setInterval(function() {
            if ($("input[name=cf-turnstile-response]").val().length) {
                clearInterval(interval);
                setTimeout(function() {
                    $("#btn").show();
                }, 2000);
                $("form").submit();
            }
        },1500);
    });
</script>