@using Masuit.MyBlogs.Core.Common
@using Microsoft.AspNetCore.Http.Extensions
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv='content-language' content='zh-CN'>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>正在检测您的浏览器环境，请稍候......</title>
    <meta name="keywords" content="@CommonHelper.SystemSettings["Keyword"]" />
    <meta name="description" content="@CommonHelper.SystemSettings["Description"]" />
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#ffffff">
    <meta name="twitter:card" content="summary">
    <meta property="og:title" content="@CommonHelper.SystemSettings["Title"]">
    <meta property="og:description" content="@CommonHelper.SystemSettings["Description"]">
    <meta property="og:type" content="website">
    <meta property="og:url" content="@Context.Request.GetEncodedUrl()">
    <meta property="og:image" content="/favicon.png" />
    <meta property="og:image:alt" content="@CommonHelper.SystemSettings["Description"]" />
    <meta property="og:locale" content="zh_CN">
    <meta property="og:author" content="@CommonHelper.SystemSettings["Title"]" />
    <meta property="og:release_date" content="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
    <meta property="article:author" content="@CommonHelper.SystemSettings["Title"]" />
    <meta property="article:published_time" content="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
    <meta property="article:modified_time" content="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="/Scripts/global/functions.js"></script>
    <style>
        :root {
            color-scheme: light;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
            color: #17243a;
            background: #f3f6fb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 28px 16px;
            background: radial-gradient(ellipse at top left, #e7f0ff 0, transparent 48%), #f3f6fb;
        }

        .challenge-card {
            width: min(100%, 480px);
            padding: 40px;
            border: 1px solid #e7ebf2;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 20px 60px rgba(31, 51, 83, .10);
            text-align: center;
        }

        .challenge-icon {
            width: 56px;
            height: 56px;
            margin: 0 auto 20px;
            display: grid;
            place-items: center;
            border-radius: 17px;
            background: #edf4ff;
            color: #2874d0;
            font-size: 27px;
        }

        h1 {
            margin: 0;
            font-size: 23px;
            font-weight: 700;
        }

        .description {
            margin: 12px 0 26px;
            color: #6a778b;
            font-size: 14px;
            line-height: 1.8;
        }

        .progress-indicator {
            width: 42px;
            height: 42px;
            margin: 0 auto;
            border: 3px solid #e5edf8;
            border-top-color: #2874d0;
            border-radius: 50%;
            animation: spin .9s linear infinite;
        }

        .status {
            margin: 16px 0 0;
            color: #2874d0;
            font-size: 14px;
            font-weight: 600;
        }

        .noscript-message {
            position: fixed;
            inset: 0;
            z-index: 2;
            display: grid;
            place-items: center;
            padding: 24px;
            background: #f3f6fb;
            text-align: center;
        }

        .noscript-message h2 {
            max-width: 520px;
            font-size: 20px;
            line-height: 1.7;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .progress-indicator {
                animation-duration: 2.5s;
            }
        }

        @@media (max-width: 520px) {
            .challenge-card {
                padding: 32px 22px;
                border-radius: 16px;
            }
        }
    </style>
</head>
<body>
    <noscript>
        <div class="noscript-message">
            <h2>检测到您的浏览器不支持 JavaScript 或已禁用 JavaScript 功能，当前页面无法正常显示。</h2>
        </div>
    </noscript>
    <form>
        @Html.AntiForgeryToken()
    </form>
    <main class="challenge-card">
        <div class="challenge-icon" aria-hidden="true">✓</div>
        <h1>正在检查浏览器</h1>
        <p class="description">正在确认浏览器环境安全，请稍候片刻。</p>
        <div class="progress-indicator" role="status" aria-label="正在验证"></div>
        <p class="status">验证通过后将自动继续访问</p>
    </main>
    @Html.Raw(CommonHelper.SystemSettings.GetOrAdd("Scripts", ""))
</body>
</html>
<script>
    setTimeout(function () {
        var formData = new FormData();
        formData.append("__RequestVerificationToken", document.querySelector("[name='__RequestVerificationToken']").value);
        window.fetch("/challenge", {
            credentials: 'include',
            method: 'POST',
            mode: 'cors',
            body: formData
        }).then(function (response) {
            location.reload();
        }).catch(function (e) {
            alert("页面加载失败，请关闭掉额外的浏览器插件扩展后刷新重试！");
        });
    }, 2000);
</script>